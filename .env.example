# Discord application bot token. Never commit a real token.
DISCORD_BOT_TOKEN=

# Optional. Set this while developing so slash commands show up immediately
# in one server. Leave empty to sync global commands (can take up to an hour).
DISCORD_GUILD_ID=

# Resend API key. Never commit a real key.
RESEND_API_KEY=

# Sender on a domain you have verified in Resend. SPF and DKIM must align
# with this domain or a routine trigger will not fire.
RESEND_FROM=Grokbot Bridge <bridge@your-verified-domain.com>

# SQLite file. Created on startup.
DATABASE_PATH=data/links.sqlite3

# Per Discord user. Counted when a mention is accepted for sending.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Same-author burst: look back 45 seconds and stop at a gap longer than 5.
BURST_WINDOW_SECONDS=45
BURST_GAP_SECONDS=5

# Channel messages shown under the earlier-channel heading. Not part of the burst.
CHANNEL_TAIL_COUNT=5

# Optional. Copied into the email body only. This bridge does not receive it.
CALLBACK_WEBHOOK_URL=
